{
  "name": "mmntjs-timezone",
  "version": "0.0.3",
  "description": "Drop-in replacement for moment-timezone",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./logic": {
      "types": "./dist/logic.d.ts",
      "import": "./dist/logic.js",
      "require": "./dist/logic.cjs"
    },
    "./1970-2030": {
      "types": "./dist/1970-2030.d.ts",
      "import": "./dist/1970-2030.js",
      "require": "./dist/1970-2030.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist", "!dist/**/*.map"],
  "scripts": {
    "prepublishOnly": "bun run build && TZ=UTC bun test ./test/runtime-smoke.test.ts",
    "build": "bun ../../scripts/generate-timezone-data.ts && tsup && bun ../../scripts/copy-dts.ts",
    "test": "bun test"
  },
  "peerDependencies": {
    "mmntjs": ">=0.0.1"
  },
  "devDependencies": {
    "fast-check": "^4.0.0",
    "moment-timezone": "^0.5.46",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoshi-taka/mmntjs.git"
  },
  "bugs": {
    "url": "https://github.com/yoshi-taka/mmntjs/issues"
  },
  "homepage": "https://github.com/yoshi-taka/mmntjs#readme",
  "license": "MIT"
}
