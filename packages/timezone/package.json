{
  "name": "mmntjs-timezone",
  "version": "1.0.0",
  "description": "Drop-in replacement for moment-timezone — powered by native Intl API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": ["dist"],
  "scripts": {
    "build": "tsup && bun ../../scripts/copy-dts.ts",
    "test": "bun test"
  },
  "peerDependencies": {
    "mmntjs": "^1.0.0"
  },
  "devDependencies": {
    "fast-check": "^4.0.0",
    "moment-timezone": "^0.5.46",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}
