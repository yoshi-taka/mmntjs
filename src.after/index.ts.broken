import { createRequire } from 'module'
const require = createRequire(import.meta.url)
const dist = require('../dist/index.cjs')

const moment = dist.default || dist.moment || dist
const isMoment = dist.isMoment
const isDate = dist.isDate
const Duration = dist.Duration
const Locale = dist.Locale

export default moment
export { moment, isMoment, isDate, Duration, Locale }
export type { MomentConfig, MomentInput } from './moment'
export type { DurationInput } from './duration'
export type { LocaleSpec } from './locale/en'
