---
import { topNav } from "../content/site";
import { withBase } from "../lib/urls";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = "mmntjs is a compatibility-first migration bridge away from moment.js.",
  currentPath = "/",
} = Astro.props;

function isActive(href: string): boolean {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        color-scheme: dark;
        --background: 222 47% 5%;
        --foreground: 214 32% 92%;
        --card: 222 38% 8%;
        --card-foreground: 214 32% 92%;
        --muted: 222 24% 14%;
        --muted-foreground: 215 18% 68%;
        --border: 217 24% 18%;
        --input: 217 24% 18%;
        --ring: 217 91% 72%;
        --primary: 217 91% 72%;
        --primary-foreground: 222 47% 7%;
        --secondary: 222 24% 13%;
        --secondary-foreground: 214 32% 92%;
        --accent: 190 95% 70%;
        --accent-foreground: 222 47% 7%;
        --success: 145 55% 68%;
        --warning: 42 88% 72%;
        --danger: 0 74% 70%;
        --radius: 1rem;
        --radius-lg: 1.5rem;
        --radius-xl: 2rem;
        --shadow-soft: 0 18px 70px rgba(0, 0, 0, 0.35);
        --shadow-card: 0 1px 0 rgba(255, 255, 255, 0.04), 0 18px 50px rgba(0, 0, 0, 0.24);
        --glow-primary: 0 0 80px rgba(90, 145, 255, 0.18);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
        min-height: 100%;
        background:
          radial-gradient(circle at 50% -10%, hsl(var(--primary) / 0.2), transparent 35rem),
          radial-gradient(circle at 86% 20%, hsl(var(--accent) / 0.08), transparent 30rem),
          radial-gradient(circle at 15% 74%, hsl(var(--primary) / 0.08), transparent 34rem),
          linear-gradient(180deg, hsl(var(--background)), hsl(222 45% 7%));
        color: hsl(var(--foreground));
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        font-feature-settings: "kern";
        line-height: 1.68;
        text-rendering: optimizeLegibility;
      }

      body::before {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        content: "";
        background-image:
          linear-gradient(hsl(var(--foreground) / 0.022) 1px, transparent 1px),
          linear-gradient(90deg, hsl(var(--foreground) / 0.018) 1px, transparent 1px);
        background-size: 56px 56px;
        mask-image: linear-gradient(to bottom, black 0%, transparent 72%);
      }

      a {
        color: hsl(var(--primary));
        text-decoration: none;
        transition:
          color 160ms ease,
          border-color 160ms ease,
          background 160ms ease,
          box-shadow 160ms ease,
          transform 160ms ease;
      }

      a:hover {
        color: hsl(var(--accent));
      }

      a:visited {
        color: hsl(var(--primary));
      }

      code,
      pre {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      }

      code {
        font-size: 0.93em;
      }

      :not(pre) > code,
      td code,
      li code,
      p code,
      span code {
        padding: 0.14rem 0.42rem;
        border: 1px solid hsl(var(--border) / 0.72);
        border-radius: 0.45rem;
        background: hsl(var(--secondary) / 0.9);
        color: hsl(var(--foreground));
        box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.04);
      }

      pre {
        position: relative;
        overflow-x: auto;
        margin: 0;
        padding: 1.25rem;
        border: 1px solid hsl(var(--border) / 0.72);
        border-radius: calc(var(--radius-lg) - 0.25rem);
        background:
          linear-gradient(180deg, hsl(222 45% 6% / 0.96), hsl(222 40% 4% / 0.96)),
          hsl(var(--background));
        box-shadow:
          inset 0 1px 0 hsl(var(--foreground) / 0.05),
          0 18px 50px rgba(0, 0, 0, 0.2);
        color: hsl(var(--card-foreground));
        font-size: 0.88rem;
        line-height: 1.72;
      }

      pre + pre {
        margin-top: 1rem;
      }

      pre::before {
        display: block;
        margin-bottom: 0.95rem;
        color: hsl(var(--muted-foreground) / 0.5);
        content: "o  o  o";
        font-size: 0.7rem;
        letter-spacing: 0.28em;
      }

      pre.shiki code {
        color: inherit;
      }

      table {
        width: 100%;
        max-width: 100%;
        display: block;
        overflow-x: auto;
        border: 1px solid hsl(var(--border) / 0.68);
        border-radius: var(--radius-lg);
        border-spacing: 0;
        border-collapse: separate;
        background: hsl(var(--card) / 0.45);
      }

      thead,
      tbody {
        display: table;
        width: 100%;
        min-width: 720px;
        table-layout: fixed;
      }

      th,
      td {
        padding: 1rem 1.05rem;
        border-bottom: 1px solid hsl(var(--border) / 0.58);
        text-align: left;
        vertical-align: top;
      }

      th {
        background: hsl(var(--muted) / 0.54);
        color: hsl(var(--foreground));
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .migration-approaches-table th {
        letter-spacing: 0.02em;
        text-transform: none;
      }

      .migration-approaches-table thead,
      .migration-approaches-table tbody {
        min-width: 980px;
        table-layout: auto;
      }

      .migration-approaches-table td,
      .migration-approaches-table th {
        overflow-wrap: anywhere;
        word-break: break-word;
      }

      .migration-approaches-table td code {
        white-space: normal;
      }

      tbody tr:hover {
        background: hsl(var(--primary) / 0.035);
      }

      tbody tr:last-child td {
        border-bottom: 0;
      }

      main {
        width: min(1180px, calc(100vw - 32px));
        margin: 0 auto;
        padding: 24px 0 92px;
      }

      header {
        position: sticky;
        top: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        margin: 0 -12px 40px;
        padding: 12px;
        border: 1px solid hsl(var(--border) / 0.36);
        border-radius: 999px;
        background: hsl(var(--background) / 0.68);
        backdrop-filter: blur(16px);
        box-shadow: 0 1px 0 hsl(var(--foreground) / 0.03);
      }

      .brand-wrap {
        display: grid;
        gap: 4px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        color: hsl(var(--foreground));
        font-size: 1.05rem;
        font-weight: 750;
        letter-spacing: -0.035em;
      }

      .brand::before {
        width: 0.62rem;
        height: 0.62rem;
        margin-right: 0.58rem;
        border-radius: 999px;
        background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
        box-shadow: 0 0 28px hsl(var(--primary) / 0.38);
        content: "";
      }

      .brand-note {
        color: hsl(var(--muted-foreground));
        font-size: 0.82rem;
      }

      nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 4px;
      }

      nav a {
        padding: 0.48rem 0.72rem;
        border: 1px solid transparent;
        border-radius: 999px;
        color: hsl(var(--muted-foreground));
        font-size: 0.9rem;
        font-weight: 520;
      }

      nav a.active {
        border-color: hsl(var(--border) / 0.64);
        background: hsl(var(--secondary) / 0.76);
        color: hsl(var(--foreground));
        box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.04);
      }

      nav a:hover {
        background: hsl(var(--secondary) / 0.52);
      }

      nav a:visited {
        color: hsl(var(--muted-foreground));
      }

      nav a.active:visited {
        color: hsl(var(--foreground));
      }

      .panel {
        border: 1px solid hsl(var(--border) / 0.72);
        border-radius: var(--radius-xl);
        background: linear-gradient(180deg, hsl(var(--card) / 0.92), hsl(var(--card) / 0.74));
        box-shadow: var(--shadow-card);
      }

      .eyebrow {
        margin: 0 0 14px;
        color: hsl(var(--primary));
        font-size: 0.82rem;
        font-weight: 650;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .page-intro {
        position: relative;
        overflow: hidden;
        margin-bottom: 48px;
        padding: clamp(2rem, 5vw, 4.8rem);
        border-radius: calc(var(--radius-xl) + 0.5rem);
        background:
          radial-gradient(circle at 18% 8%, hsl(var(--primary) / 0.2), transparent 24rem),
          radial-gradient(circle at 92% 20%, hsl(var(--accent) / 0.1), transparent 22rem),
          linear-gradient(180deg, hsl(var(--card) / 0.94), hsl(var(--card) / 0.68));
        box-shadow: var(--shadow-soft), var(--glow-primary);
      }

      .page-intro.hero {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(370px, 0.7fr);
        align-items: center;
        gap: clamp(2.5rem, 6vw, 5rem);
        min-height: min(680px, calc(100vh - 120px));
        padding-bottom: clamp(2.5rem, 5vw, 5rem);
      }

      .page-intro::after {
        position: absolute;
        inset: 1px;
        pointer-events: none;
        border-radius: inherit;
        box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.07);
        content: "";
      }

      .page-intro-compact {
        position: relative;
        margin: 1.5rem 0 2.5rem;
        padding: clamp(1.5rem, 3vw, 2.75rem);
        border: 1px solid hsl(var(--border) / 0.55);
        border-radius: calc(var(--radius-xl) + 0.35rem);
        background:
          radial-gradient(circle at 12% 0%, hsl(var(--primary) / 0.1), transparent 18rem),
          linear-gradient(180deg, hsl(var(--card) / 0.72), hsl(var(--card) / 0.48));
        box-shadow: 0 14px 48px rgba(0, 0, 0, 0.22), var(--glow-primary);
        overflow: visible;
      }

      .page-intro-compact::after {
        position: absolute;
        inset: 1px;
        pointer-events: none;
        border-radius: inherit;
        box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.07);
        content: "";
      }

      .page-intro-compact h1 {
        max-width: 18ch;
        margin: 0;
        font-size: clamp(2.4rem, 5vw, 4.6rem);
        font-weight: 780;
        line-height: 0.98;
        letter-spacing: -0.055em;
        text-wrap: balance;
        color: hsl(var(--foreground));
      }

      .page-intro-compact p {
        max-width: 68ch;
        margin-top: 0.85rem;
        color: hsl(var(--muted-foreground));
        font-size: clamp(1rem, 1.4vw, 1.12rem);
        line-height: 1.7;
      }

      .page-intro-compact .eyebrow {
        margin-bottom: 10px;
      }

      .page-intro h1 {
        margin: 0;
        max-width: 14em;
        text-wrap: balance;
        color: hsl(var(--foreground));
        font-size: clamp(3.1rem, 6.1vw, 5.35rem);
        font-weight: 780;
        letter-spacing: -0.055em;
        line-height: 0.96;
      }

      .docs-hero,
      .docs-hero-flat {
        overflow: visible;
      }

      .docs-hero h1 {
        max-width: 12ch;
        font-size: clamp(2.5rem, 5.2vw, 4.45rem);
        letter-spacing: -0.045em;
        line-height: 1.02;
      }

      .docs-hero-flat {
        margin: clamp(3rem, 8vw, 6rem) 0 clamp(3rem, 7vw, 5rem);
        padding: 0;
        background: none;
        border: 0;
        box-shadow: none;
      }

      .docs-hero-flat::after {
        display: none;
      }

      .docs-hero-flat .eyebrow {
        margin-bottom: 1.5rem;
        letter-spacing: 0.16em;
      }

      .docs-hero-flat h1 {
        max-width: 12ch;
        margin: 0;
        color: hsl(var(--foreground));
        font-size: clamp(2.55rem, 6.4vw, 5rem);
        line-height: 0.95;
        letter-spacing: -0.065em;
        text-wrap: balance;
      }

      .docs-hero-flat p {
        max-width: 62ch;
        margin-top: 1.5rem;
        color: hsl(var(--muted-foreground));
        font-size: clamp(1.05rem, 1.6vw, 1.2rem);
        line-height: 1.75;
      }

      .hero-copy {
        position: relative;
        z-index: 1;
      }

      .page-intro p {
        margin: 28px 0 0;
        max-width: 700px;
        color: hsl(var(--muted-foreground));
        font-size: clamp(1.05rem, 2vw, 1.2rem);
        line-height: 1.72;
      }

      .hero-code-card {
        position: relative;
        z-index: 1;
        overflow: hidden;
        border: 1px solid hsl(var(--border) / 0.8);
        border-radius: calc(var(--radius-xl) + 0.15rem);
        background:
          radial-gradient(circle at 20% 0%, hsl(var(--primary) / 0.14), transparent 17rem),
          linear-gradient(180deg, hsl(222 40% 9% / 0.96), hsl(222 42% 5% / 0.96));
        box-shadow:
          inset 0 1px 0 hsl(var(--foreground) / 0.07),
          0 26px 80px rgba(0, 0, 0, 0.36),
          0 0 70px hsl(var(--primary) / 0.1);
      }

      .hero-code-card::before {
        display: flex;
        align-items: center;
        min-height: 3.1rem;
        padding: 0 1.25rem;
        border-bottom: 1px solid hsl(var(--border) / 0.62);
        color: hsl(var(--muted-foreground));
        content: "o  o  o    mmntjs";
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.75rem;
        letter-spacing: 0.12em;
      }

      .code-step {
        padding: 1.2rem;
      }

      .code-step + .code-step {
        border-top: 1px solid hsl(var(--border) / 0.58);
      }

      .code-step .eyebrow {
        margin-bottom: 0.8rem;
        color: hsl(var(--muted-foreground));
        font-size: 0.72rem;
      }

      .hero-code-card pre {
        padding: 0;
        border: 0;
        border-radius: 0;
        background: transparent;
        box-shadow: none;
        font-size: 0.92rem;
      }

      .hero-code-card pre::before {
        display: none;
      }

      .hero-code-card pre.shiki {
        background: transparent !important;
        background-color: transparent !important;
      }

      .page-intro .section {
        margin-top: 0;
        padding: 1.4rem;
        border-radius: var(--radius-lg);
      }

      .section {
        margin-top: 28px;
        padding: clamp(1.35rem, 2.8vw, 2rem);
        overflow-x: auto;
      }

      .section h2,
      .section h3 {
        margin: 0 0 12px;
        color: hsl(var(--foreground));
        letter-spacing: -0.035em;
        line-height: 1.12;
      }

      .section h2 {
        font-size: clamp(1.55rem, 2.8vw, 2.25rem);
      }

      .section p,
      .section li {
        color: hsl(var(--muted-foreground));
        line-height: 1.72;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
      }

      .cards {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .docs-card-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
      }

      .docs-card {
        display: block;
        padding: 1rem;
        border: 1px solid hsl(var(--border) / 0.5);
        border-radius: var(--radius-lg);
        background: hsl(var(--secondary) / 0.35);
      }

      .docs-card h3 {
        margin: 0 0 0.5rem;
        color: hsl(var(--foreground));
        font-size: 0.95rem;
        font-weight: 650;
      }

      .docs-card p {
        margin: 0;
        color: hsl(var(--muted-foreground));
        font-size: 0.88rem;
        line-height: 1.6;
        max-width: 40ch;
      }

      .docs-card:hover {
        border-color: hsl(var(--primary) / 0.4);
        background: hsl(var(--secondary) / 0.55);
      }

      .diff-cards {
        display: grid;
        gap: 16px;
      }

      .docs-layout {
        display: grid;
        grid-template-columns: 200px minmax(0, 680px) minmax(200px, 260px);
        gap: 32px;
        align-items: start;
      }

      .docs-nav {
        position: sticky;
        top: 5.5rem;
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
      }

      .docs-nav-group {
        display: flex;
        flex-direction: column;
      }

      .docs-nav-label {
        margin: 0 0 2px;
        padding: 4px 10px;
        color: hsl(var(--muted-foreground));
        font-size: 0.7rem;
        font-weight: 650;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .docs-nav-link {
        padding: 4px 10px;
        border-radius: 6px;
        color: hsl(var(--muted-foreground));
        font-size: 0.85rem;
        line-height: 1.4;
        transition: background 100ms ease, color 100ms ease;
      }

      .docs-nav-link:hover {
        background: hsl(var(--secondary) / 0.5);
        color: hsl(var(--foreground));
      }

      .docs-nav-link.active {
        background: hsl(var(--primary) / 0.1);
        color: hsl(var(--primary));
        font-weight: 550;
      }

      .docs-article {
        min-width: 0;
      }

      .docs-article h2 {
        margin: 0 0 1rem;
        color: hsl(var(--foreground));
        font-size: clamp(1.45rem, 2vw, 2rem);
        line-height: 1.2;
        letter-spacing: -0.035em;
      }

      .docs-article h3 {
        margin: 0 0 0.75rem;
        font-size: 1.15rem;
        line-height: 1.25;
        letter-spacing: -0.025em;
      }

      .docs-article p {
        color: hsl(var(--muted-foreground));
        line-height: 1.78;
      }

      .docs-article p + p {
        margin-top: 1rem;
      }

      .docs-article ul {
        margin: 1rem 0 0;
        padding-left: 1.2rem;
      }

      .docs-article li + li {
        margin-top: 0.45rem;
      }

      .docs-section {
        margin-top: 3rem;
      }

      .docs-section:first-child {
        margin-top: 0;
      }

      .docs-prose-block + .docs-prose-block {
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid hsl(var(--border) / 0.4);
      }

      .docs-section .eyebrow {
        margin-bottom: 1.5rem;
      }

      .docs-intro {
        margin-bottom: 2rem;
      }

      .docs-intro .eyebrow {
        letter-spacing: 0.16em;
      }

      .docs-intro h1 {
        margin: 0;
        color: hsl(var(--foreground));
        font-size: clamp(2.2rem, 4vw, 3.2rem);
        font-weight: 780;
        letter-spacing: -0.045em;
        line-height: 1;
      }

      .docs-intro p {
        margin: 1rem 0 0;
        max-width: 640px;
        color: hsl(var(--muted-foreground));
        font-size: clamp(1.05rem, 1.5vw, 1.15rem);
        line-height: 1.72;
      }

      .docs-sidebar {
        position: sticky;
        top: 6rem;
        display: grid;
        gap: 1rem;
      }

      .docs-sidebar-card {
        border: 1px solid hsl(var(--border) / 0.5);
        border-radius: var(--radius-lg);
        background: hsl(var(--card) / 0.4);
        padding: 1rem;
      }

      .docs-sidebar-card h2 {
        margin: 0 0 0.75rem;
        color: hsl(var(--foreground));
        font-size: 0.78rem;
        font-weight: 650;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .docs-sidebar-card p,
      .docs-sidebar-card li {
        color: hsl(var(--muted-foreground));
        font-size: 0.9rem;
        line-height: 1.6;
      }

      .docs-sidebar-card ul {
        margin: 0;
        padding-left: 1rem;
      }

      .docs-sidebar-card li + li {
        margin-top: 0.35rem;
      }

      .example-list {
        display: grid;
        gap: 1rem;
      }

      .example-card {
        border: 1px solid hsl(var(--border) / 0.6);
        border-radius: var(--radius-lg);
        background: hsl(var(--secondary) / 0.45);
        padding: 1.1rem;
      }

      .example-card h3 {
        margin-bottom: 1rem;
      }

      .example-card pre {
        margin-top: 0.75rem;
      }

      .example-card p {
        margin-top: 0.9rem;
        font-size: 0.95rem;
        color: hsl(var(--muted-foreground));
      }

      .difference-list {
        display: grid;
        gap: 2rem;
      }

      .difference-entry + .difference-entry {
        padding-top: 2rem;
        border-top: 1px solid hsl(var(--border) / 0.42);
      }

      .difference-entry h3 {
        max-width: 34rem;
        font-size: clamp(1.05rem, 1.5vw, 1.3rem);
        line-height: 1.18;
        letter-spacing: -0.035em;
      }

      .difference-entry .meta-list {
        margin-top: 1.1rem;
        gap: 0.9rem;
      }

      .difference-entry .meta-row {
        grid-template-columns: 1fr;
        gap: 0.28rem;
      }

      .difference-entry .label {
        color: hsl(var(--muted-foreground));
        font-size: 0.78rem;
        font-weight: 650;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .card {
        display: block;
        padding: 1.15rem;
        border: 1px solid hsl(var(--border) / 0.64);
        border-radius: var(--radius-lg);
        background: hsl(var(--secondary) / 0.55);
        box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.025);
      }

      .card h3 {
        margin: 0 0 8px;
        color: hsl(var(--foreground));
        font-size: 1.02rem;
      }

      .card p,
      .card li {
        margin: 0;
        color: hsl(var(--muted-foreground));
      }

      .card:first-child:nth-last-child(3) {
        background:
          radial-gradient(circle at 20% 0%, hsl(var(--primary) / 0.1), transparent 18rem),
          hsl(var(--secondary) / 0.64);
      }

      .meta-list {
        display: grid;
        gap: 10px;
      }

      .meta-row {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 12px;
      }

      .label {
        color: hsl(var(--foreground));
        font-weight: 600;
      }

      .tag {
        display: inline-flex;
        align-items: center;
        white-space: nowrap;
        padding: 0.24rem 0.56rem;
        border-radius: 999px;
        border: 1px solid hsl(var(--border) / 0.72);
        background: hsl(var(--secondary) / 0.68);
        color: hsl(var(--foreground));
        font-size: 0.76rem;
        font-weight: 650;
        letter-spacing: 0.035em;
        text-transform: uppercase;
      }

      .tag.compatible {
        border-color: hsl(var(--success) / 0.35);
        background: hsl(var(--success) / 0.1);
        color: hsl(var(--success));
      }

      .tag.partial,
      .tag.mostly-compatible {
        border-color: hsl(var(--warning) / 0.35);
        background: hsl(var(--warning) / 0.1);
        color: hsl(var(--warning));
      }

      .tag.not-supported,
      .tag.unsupported {
        border-color: hsl(var(--danger) / 0.35);
        background: hsl(var(--danger) / 0.1);
        color: hsl(var(--danger));
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 1rem;
        border: 1px solid hsl(var(--border) / 0.78);
        border-radius: calc(var(--radius) - 0.25rem);
        background: hsl(var(--secondary) / 0.68);
        color: hsl(var(--secondary-foreground));
        font-size: 0.94rem;
        font-weight: 650;
        box-shadow: inset 0 1px 0 hsl(var(--foreground) / 0.04);
      }

      .button:visited {
        color: hsl(var(--secondary-foreground));
      }

      .button:hover {
        border-color: hsl(var(--primary) / 0.42);
        background: hsl(var(--secondary) / 0.9);
        color: hsl(var(--foreground));
        transform: translateY(-1px);
      }

      .button.primary {
        background: linear-gradient(135deg, hsl(var(--primary)), hsl(var(--accent)));
        border-color: transparent;
        color: hsl(var(--primary-foreground));
        box-shadow: 0 0 36px hsl(var(--primary) / 0.18);
      }

      .button.primary:visited {
        color: hsl(var(--primary-foreground));
      }

      .button.primary:hover {
        color: hsl(var(--primary-foreground));
        box-shadow: 0 0 46px hsl(var(--primary) / 0.24);
      }

      footer {
        margin-top: 40px;
        padding-top: 24px;
        border-top: 1px solid hsl(var(--border) / 0.7);
        color: hsl(var(--muted-foreground));
        font-size: 0.95rem;
      }

      @media (max-width: 960px) {
        header,
        .grid,
        .cards,
        .docs-card-grid,
        .meta-row {
          grid-template-columns: 1fr;
          display: grid;
        }

        .docs-layout {
          grid-template-columns: 1fr;
        }

        .docs-nav {
          display: none;
        }

        .docs-sidebar {
          position: static;
        }

        header {
          justify-content: stretch;
          position: static;
          margin: 0 0 28px;
          border-radius: var(--radius-lg);
        }

        nav {
          justify-content: flex-start;
        }
      }

      @media (max-width: 720px) {
        .difference-entry .meta-row {
          gap: 0.35rem;
        }
      }

      @media (max-width: 640px) {
        main {
          width: min(100% - 24px, 1180px);
          padding-top: 12px;
        }

        .brand-note {
          display: none;
        }

        .page-intro.hero {
          grid-template-columns: 1fr;
          min-height: auto;
        }

        .page-intro {
          padding: 1.5rem;
        }

        .page-intro h1 {
          font-size: clamp(2.45rem, 11.5vw, 3.6rem);
          letter-spacing: -0.045em;
        }

        .page-intro-compact {
          margin: 0.75rem 0 1.5rem;
          padding: 1.25rem;
        }

        .page-intro-compact h1 {
          font-size: clamp(2rem, 9vw, 3rem);
          letter-spacing: -0.04em;
        }

        .actions,
        .button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <header>
        <div class="brand-wrap">
          <a class="brand" href={withBase("/")}>mmntjs</a>
          <div class="brand-note">Compatibility-first migration bridge away from moment.js</div>
        </div>
        <nav>
          {topNav.map((link) => (
            <a
              class={!link.external && isActive(link.href) ? "active" : undefined}
              href={link.external ? link.href : withBase(link.href)}
              target={link.external ? "_blank" : undefined}
              rel={link.external ? "noreferrer" : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </header>
      <slot />
      <footer>
        mmntjs is positioned as a practical migration bridge: preserve behavior first, modernize on your own schedule.
      </footer>
    </main>
  </body>
</html>
