---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { migrationPhases } from "../../content/site";

const checklist = [
  "Inventory custom parsing and custom format usage.",
  "Identify timezone and locale heavy modules early.",
  "Verify invalid-date behavior in both UI and business logic paths.",
  "Expand rollout only after production-like comparisons pass.",
];

const testStrategy = [
  "Run the tests you already trust before writing new migration-specific wrappers.",
  "Add a small set of targeted comparisons for parsing, invalid dates, offsets, and DST boundaries.",
  "Prefer module-level rollout so failures have a clear owner and rollback path.",
];

const doNotRush = [
  "Do not start with your most time-sensitive billing, reporting, or scheduling path.",
  "Do not treat a benchmark win as evidence of behavioral safety.",
  "Do not assume timezone-heavy code is low-risk just because the tests are green in UTC.",
];

const rolloutExamples = [
  {
    title: "Example A: package-by-package migration in a monorepo",
    steps: [
      "Start with one internal package that formats and compares dates but does not own timezone-heavy scheduling logic.",
      "Replace imports in that package only and run its tests plus a small integration slice that consumes it.",
      "Add a few explicit fixtures for custom parsing, invalid inputs, and date-boundary math before expanding to the next package.",
    ],
  },
  {
    title: "Example B: service-by-service migration",
    steps: [
      "Begin with a service that has clear ownership and a deploy path independent from billing or scheduling-critical systems.",
      "Switch the import path, compare outputs in staging or canary logs, then expand after those comparisons stay boring for a full release cycle.",
      "Leave higher-risk services on moment.js longer if needed; controlled uneven rollout is better than a misleading all-at-once switch.",
    ],
  },
];

const comparisonChecklist = [
  "A custom-format parse example your application already relies on",
  "An invalid input that should stay invalid",
  "A timezone-offset or parseZone example used in production",
  "A DST-adjacent example if the system operates in local time",
  "A locale-sensitive format used in customer-visible output or exported reports",
];
---

<BaseLayout
  title="Migration | mmntjs"
  description="Practical rollout guidance for teams migrating away from moment.js without a risky rewrite."
  currentPath="/migration/"
>
  <section class="page-intro panel">
    <p class="eyebrow">Migration</p>
    <h1>Roll out in stages, not in hope.</h1>
    <p>
      This page is for teams that need a realistic adoption path: evaluate first, replace in a
      small surface, compare behavior, then expand with confidence.
    </p>
  </section>

  <section class="panel section">
    <p class="eyebrow">Migration Overview</p>
    <p>
      The safest way to adopt mmntjs is to treat it as a compatibility bridge first and an
      optimization or modernization step second. Teams usually get better results by reducing the
      migration surface one ownership boundary at a time instead of attempting a global swap.
    </p>
    <p>
      A good migration plan also makes room for the possibility that a few modules should stay on
      moment.js longer than others. That is not failure. It is a controlled rollout doing its job.
    </p>
  </section>

  <section class="panel section">
    <p class="eyebrow">Staged Rollout</p>
    <div class="cards">
      {migrationPhases.map(([phase, text]) => (
        <article class="card">
          <h3>{phase}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="panel section">
    <p class="eyebrow">Concrete Rollout Examples</p>
    <div class="cards">
      {rolloutExamples.map((example) => (
        <article class="card">
          <h3>{example.title}</h3>
          <ol>
            {example.steps.map((step) => <li>{step}</li>)}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="grid">
    <article class="panel section">
      <p class="eyebrow">Good Fit</p>
      <ul>
        <li>Large codebases with deep moment.js usage.</li>
        <li>Teams that need behavioral continuity before broader modernization.</li>
        <li>Owners who can stage adoption by module, package, or service.</li>
      </ul>
    </article>
    <article class="panel section">
      <p class="eyebrow">Use Caution</p>
      <ul>
        <li>Critical timezone-data workflows that assume full IANA behavior in core.</li>
        <li>Codebases with little or no regression testing around date parsing and formatting.</li>
        <li>Rollouts that demand a same-day global replacement without verification time.</li>
      </ul>
    </article>
  </section>

  <section class="grid">
    <article class="panel section">
      <p class="eyebrow">Testing Strategy</p>
      <ul>
        {testStrategy.map((item) => <li>{item}</li>)}
      </ul>
    </article>
    <article class="panel section">
      <p class="eyebrow">What Not To Rush</p>
      <ul>
        {doNotRush.map((item) => <li>{item}</li>)}
      </ul>
    </article>
  </section>

  <section class="panel section">
    <p class="eyebrow">Risk Checklist</p>
    <ul>
      {checklist.map((item) => <li>{item}</li>)}
    </ul>
    <p>
      If your team can complete this checklist for one low-risk module first, the next expansion
      step becomes much more credible to reviewers and maintainers.
    </p>
  </section>

  <section class="panel section">
    <p class="eyebrow">Minimal Comparison Set</p>
    <p>
      Before expanding beyond the first module or service, keep a tiny comparison set that reflects
      the way your application actually uses dates. It does not need to be large. It needs to be
      representative.
    </p>
    <ul>
      {comparisonChecklist.map((item) => <li>{item}</li>)}
    </ul>
  </section>
</BaseLayout>
