---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { docsPrimarySlugs, getDocsSidebarGroups } from "../../content/docs-nav";
import { docsPages } from "../../content/site";
import { withBase } from "../../lib/urls";

const primaryDocs = docsPages.filter((page) => docsPrimarySlugs.includes(page.slug));
const referenceDocs = docsPages.filter((page) => !docsPrimarySlugs.includes(page.slug));
const sidebarGroups = getDocsSidebarGroups(true);
---

<BaseLayout
  title="Docs | mmntjs"
  description="Practical, migration-oriented documentation for evaluating and adopting mmntjs."
  currentPath="/docs/"
>
  <div class="docs-layout">
    <nav class="docs-nav">
      {sidebarGroups.map((group) => (
        <div class="docs-nav-group">
          <p class="docs-nav-label">{group.label}</p>
          {group.pages.map((page) => (
            <a
              class={`docs-nav-link${page.slug === "" ? " active" : ""}`}
              href={page.slug === "" ? withBase("/docs/") : withBase(`/docs/${page.slug}/`)}
            >
              {page.title}
            </a>
          ))}
        </div>
      ))}
    </nav>
    <article class="docs-article">
      <section class="docs-hero-flat">
        <p class="eyebrow">Docs</p>
        <h1>Documentation organized for migration risk.</h1>
        <p>
          The docs prioritize the questions large codebases ask first: what is compatible, what is
          risky, what to test, and how to roll out incrementally.
        </p>
      </section>

      <section class="panel section">
        <p class="eyebrow">Start Here</p>
        <div class="docs-card-grid">
          {primaryDocs.map((page) => (
            <a class="docs-card" href={withBase(`/docs/${page.slug}/`)}>
              <h3>{page.title}</h3>
              <p>{page.summary}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="panel section">
        <p class="eyebrow">Reference Paths</p>
        <div class="docs-card-grid">
          {referenceDocs.map((page) => (
            <a class="docs-card" href={withBase(`/docs/${page.slug}/`)}>
              <h3>{page.title}</h3>
              <p>{page.summary}</p>
            </a>
          ))}
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
