---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import { getDocsSidebarGroups } from "../../content/docs-nav";
import { docsPages, knownDifferences } from "../../content/site";
import { renderInlineCodeHTML } from "../../lib/inline-code";
import { withBase } from "../../lib/urls";

type DocSection = {
  title: string;
  body: string[];
  bullets?: string[];
};

type DocExample = {
  title: string;
  code: string;
  language: string;
  note?: string;
};

const docSections: Record<string, DocSection[]> = {
  "getting-started": [
