};

export function getStaticPaths() {
  return docsPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;
const sections = docSections[page.slug] ?? [];
const pageKnownDifferences = page.slug === "known-differences" ? knownDifferences : [];
const pageExamples = docExamples[page.slug] ?? [];

const sidebarGroups = getDocsSidebarGroups();
---

<BaseLayout
  title={`${page.title} | mmntjs Docs`}
  description={page.summary}
  currentPath={`/docs/${page.slug}/`}
>
  <div class="docs-layout">
    <nav class="docs-nav">
      {sidebarGroups.map((group) => (
        <div class="docs-nav-group">
          <p class="docs-nav-label">{group.label}</p>
          {group.pages.map((docPage) => (
            <a
              class={`docs-nav-link${docPage.slug === page.slug ? " active" : ""}`}
              href={withBase(`/docs/${docPage.slug}/`)}
            >
              {docPage.title}
            </a>
          ))}
        </div>
      ))}
    </nav>
    <article class="docs-article">
      <section class="docs-header">
        <p class="eyebrow">Docs</p>
        <h1>{page.title}</h1>
        <p set:html={renderInlineCodeHTML(page.summary)} />
      </section>

      {sections.length > 0 && (
        <section class="docs-section">
          <p class="eyebrow">Guidance</p>
          {sections.map((section) => (
            <section class="docs-prose-block">
              <h2>{section.title}</h2>
              {section.body.map((paragraph) => <p set:html={renderInlineCodeHTML(paragraph)} />)}
              {section.bullets && (
                <ul>
                  {section.bullets.map((item) => <li set:html={renderInlineCodeHTML(item)} />)}
                </ul>
              )}
            </section>
          ))}
        </section>
      )}

      {pageExamples.length > 0 && (
        <section class="docs-section">
          <p class="eyebrow">Examples</p>
          <div class="example-list">
            {pageExamples.map((example) => (
              <article class="example-card">
                <h3>{example.title}</h3>
                <CodeBlock code={example.code} lang={example.language} />
                {example.note && <p set:html={renderInlineCodeHTML(example.note)} />}
              </article>
            ))}
          </div>
        </section>
      )}

      {pageKnownDifferences.length > 0 && (
        <section class="docs-section">
          <p class="eyebrow">Tracked Differences</p>
          <div class="difference-list">
            {pageKnownDifferences.map((item) => (
              <article class="difference-entry">
                  <p class="eyebrow">{item.category}</p>
                <h3>{item.title}</h3>
                <div class="meta-list">
                  <div class="meta-row">
                    <div class="label">moment.js</div>
                    <div set:html={renderInlineCodeHTML(item.momentBehavior)} />
                  </div>
                  <div class="meta-row">
                    <div class="label">mmntjs</div>
                    <div set:html={renderInlineCodeHTML(item.mmntjsBehavior)} />
                  </div>
                  <div class="meta-row">
                    <div class="label">Impact</div>
                    <div set:html={renderInlineCodeHTML(item.impact)} />
                  </div>
                  <div class="meta-row">
                    <div class="label">Workaround</div>
                    <div set:html={renderInlineCodeHTML(item.workaround)} />
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="docs-section">
        <p class="eyebrow">How To Use This Doc</p>
        <p>
          Use this page as a migration review aid rather than as a generic tutorial. If the behavior in
          this area is business-critical, compare it directly against your current moment.js usage and
          record the outcome before expanding rollout.
        </p>
        {page.slug === "known-differences" && (
          <p>
            The goal is not to eliminate every caveat before evaluation starts. The goal is to make the
            currently known caveats visible enough that they can be tested deliberately rather than
            discovered accidentally in production.
          </p>
        )}
      </section>
    </article>

    <aside class="docs-sidebar">
        <div class="docs-sidebar-card">
          <h2>Purpose</h2>
          <p set:html={renderInlineCodeHTML(page.purpose)} />
        </div>
        <div class="docs-sidebar-card">
          <h2>Document first</h2>
          <ul>
            {(page.focus ?? []).map((item) => <li set:html={renderInlineCodeHTML(item)} />)}
          </ul>
        </div>
        <div class="docs-sidebar-card">
          <h2>Related</h2>
          {(page.related ?? []).map((link, index) => (
            <span>
              {index > 0 && <br />}
              <a href={withBase(link.href)}>{link.label}</a>
            </span>
          ))}
        </div>
    </aside>
  </div>
</BaseLayout>
