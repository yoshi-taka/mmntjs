---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { changelogEntries } from "../../content/site";
---

<BaseLayout
  title="Changelog | mmntjs"
  description="Compatibility, quality, and migration-relevant changes for mmntjs releases and milestones."
  currentPath="/changelog/"
>
  <section class="page-intro panel">
    <p class="eyebrow">Changelog</p>
    <h1>Behavior changes deserve release notes.</h1>
    <p>
      Compatibility-sensitive users care about semantic shifts as much as features. This page should
      make behavior-impacting changes easy to review before adoption or upgrade.
    </p>
  </section>

  <section class="panel section">
    <p class="eyebrow">Current Shape</p>
    <ul>
      <li>Highlight compatibility improvements separately from features.</li>
      <li>Call out known behavior changes explicitly.</li>
      <li>Include migration-relevant notes and links to issues or docs when applicable.</li>
    </ul>
  </section>

  <section class="panel section">
    <p class="eyebrow">Recent Milestones</p>
    <div class="cards">
      {changelogEntries.map((entry) => (
        <article class="card">
          <h3>{entry.date} · {entry.title}</h3>
          <ul>
            {entry.notes.map((note) => <li>{note}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
