{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "test/*.test.ts",
    "test/*.js",
    "packages/timezone/src/index.ts",
    "packages/timezone/test/*.test.ts",
    "test/properties/basic.test.ts",
    "test/properties/boundary.test.ts",
    "test/properties/dst-oracle.test.ts"
  ],
  "project": ["src/**", "test/**", "packages/timezone/src/**"],
  "ignore": [
    "test/moment/**",
    "test/helpers/**",
    "test/oracle.ts",
    "test/locale/**",
    "test/bench-datefns.ts",
    "test/locale-helper.ts",
    "test/properties/equivalence.test.ts",
    "test/bench-*",
    "test/bench*.ts",
    "test/bench*.mjs",
    "test/fuzz/**",
    "test/properties/metamorphic.test.ts",
    "test/properties/number-theory.test.ts",
    "test/browser-bundle-compare.ts",
    "moment/**",
    "test/grafana-compat/**"
  ],
  "tags": ["-public"],
  "ignoreDependencies": [
    "date-fns",
    "dayjs",
    "luxon",
    "moment-timezone",
    "@rspack/cli",
    "@rspack/core",
    "@date-fns/tz",
    "@date-fns/utc",
    "date-fns-tz"
  ]
}
