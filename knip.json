{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "test/*.test.ts",
    "test/*.js",
    "packages/timezone/src/index.ts",
    "packages/timezone/src/logic.ts",
    "packages/timezone/src/1970-2030.ts",
    "packages/timezone/test/*.test.ts",
    "test/properties/basic.test.ts",
    "test/properties/boundary.test.ts",
    "test/properties/dst-oracle.test.ts",
    "test/properties/api-pbt.test.ts"
  ],
  "project": ["src/**", "test/**", "packages/timezone/src/**"],
  "ignore": [
    "test/moment/**",
    "test/helpers/**",
    "test/oracle.ts",
    "test/locale/**",
    "test/bench-datefns.ts",
    "test/locale-helper.ts",
    "test/properties/equivalence.test.ts",
    "test/bench-*",
    "test/bench*.ts",
    "test/bench*.mjs",
    "test/fuzz/**",
    "test/properties/metamorphic.test.ts",
    "test/properties/number-theory.test.ts",
    "test/browser-bundle-compare.ts",
    "test/grafana-compat/**",
    "test/kibana-compat/**",
    "src/format-tokens.ts",
    "src/types.ts",
    "src/entry/types.ts",
    "src/entry/temporal.ts",
    "src/core/factory-lite.ts",
    "src/display/format.ts",
    "src/format.ts",
    "src/locale.ts"
  ],
  "tags": ["-public"],
  "ignoreDependencies": [
    "date-fns",
    "dayjs",
    "luxon",
    "@rspack/cli",
    "@rspack/core",
    "@date-fns/tz",
    "@date-fns/utc",
    "date-fns-tz",
    "@types/benchmark",
    "benchmark"
  ]
}
